# Local dev only — never real secrets.
# Backend API (scan engine + UI API)
BACKEND_PORT=8000
DEMO_API_URL=http://127.0.0.1:8001
# Comma-separated extra lab targets allowed to scan (beyond localhost).
# Example: ALLOWED_TARGETS=http://127.0.0.1:8001,http://localhost:3001
ALLOWED_TARGETS=http://127.0.0.1:8001,http://localhost:8001
# Allow private-network targets (10/172.16/192.168) for controlled lab use. Keep false by default.
ALLOW_PRIVATE_TARGETS=false
# Scan execution defaults
SCAN_TIMEOUT_SECS=10
SCAN_MAX_CONCURRENCY=5
SCAN_RATE_DELAY_SECS=0.05
# Demo API
DEMO_PORT=8001
DEMO_JWT_SECRET=local-demo-secret-do-not-use-in-prod
DEMO_JWT_EXP_MINUTES=60
